# ============================================================
# CrisisPilot Backend Environment Configuration
# ============================================================

PROJECT_NAME=CrisisPilot
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Database Configuration (PostgreSQL in production/Docker, SQLite supported for local testing)
# PostgreSQL asyncpg URL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crisispilot
# Local SQLite alternative:
# DATABASE_URL=sqlite+aiosqlite:///./crisispilot.db

# Security & Authentication
JWT_SECRET=production_quality_secret_key_change_in_production_2026_crisispilot
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# HindSight by Vectorize (Organizational Memory Engine)
# For local dev or offline mode, leave key blank to use verified institutional precedents
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=organization

# LLM Provider Configuration ("groq", "openai", or deterministic fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Optional Redis Cache
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
